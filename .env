# Dominio publico donde vive la pagina, SIN barra al final.
#
# Lo usan las tags og: de index.html, que necesitan URL absoluta: los scrapers
# de WhatsApp y Telegram leen el HTML crudo desde su propio servidor, sin
# contexto de dominio, asi que una ruta relativa como /og-cafeteria.jpg no la
# pueden resolver y el link llega sin imagen.
#
# Vite reemplaza %VITE_SITE_URL% en index.html al compilar, asi que este es el
# unico lugar donde hay que tocarlo. Va commiteado a proposito: no es un secreto
# y tiene que viajar con el repo.
VITE_SITE_URL=https://coffee-landing-caba.vercel.app
